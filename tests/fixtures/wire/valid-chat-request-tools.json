{
  "model": "test-model-b",
  "stream": true,
  "stream_options": {
    "include_usage": true
  },
  "temperature": 0.2,
  "max_completion_tokens": 512,
  "tool_choice": "auto",
  "response_format": {
    "type": "json_schema",
    "json_schema": {
      "name": "synthetic_fixture_summary",
      "strict": true,
      "schema": {
        "type": "object",
        "properties": {
          "region": { "type": "string" },
          "unit": { "type": "string" }
        },
        "required": ["region", "unit"],
        "additionalProperties": false
      }
    }
  },
  "tools": [
    {
      "type": "function",
      "function": {
        "name": "lookup_unit",
        "description": "Synthetic fixture tool. Returns a unit label for a region code.",
        "parameters": {
          "type": "object",
          "properties": {
            "region": {
              "type": "string",
              "description": "Synthetic region code."
            }
          },
          "required": ["region"],
          "additionalProperties": false
        }
      }
    }
  ],
  "messages": [
    {
      "role": "system",
      "content": "Synthetic fixture system message."
    },
    {
      "role": "user",
      "content": [
        {
          "type": "text",
          "text": "Synthetic multipart fixture: describe the attached placeholder image."
        },
        {
          "type": "image_url",
          "image_url": {
            "url": "data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAAAAAA6fptVAAAACklEQVR4nGP4DwABAQEAWk1v8QAAAABJRU5ErkJggg==",
            "detail": "low"
          }
        }
      ]
    },
    {
      "role": "assistant",
      "content": null,
      "tool_calls": [
        {
          "id": "call_fixture_0",
          "type": "function",
          "function": {
            "name": "lookup_unit",
            "arguments": "{\"region\": \"synthetic-region-1\"}"
          }
        },
        {
          "id": "call_fixture_1",
          "type": "function",
          "function": {
            "name": "lookup_unit",
            "arguments": "{\"region\": \"synthetic-region-2\"}"
          }
        }
      ]
    },
    {
      "role": "tool",
      "tool_call_id": "call_fixture_0",
      "content": "{\"unit\": \"metric\"}"
    },
    {
      "role": "tool",
      "tool_call_id": "call_fixture_1",
      "content": "{\"unit\": \"imperial\"}"
    },
    {
      "role": "user",
      "content": "Summarize both synthetic tool results."
    }
  ],
  "_hermes_auto": {
    "protocol_version": 1,
    "root_session_id": "synthetic-session-0000",
    "virtual_model": "auto:balanced",
    "plugin_version": "0.1.0"
  }
}
